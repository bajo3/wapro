# Panel Backend (Whaticket) — example

NODE_ENV=production

# Public URLs (no trailing slash)
FRONTEND_URL=https://your-frontend.up.railway.app
BACKEND_URL=https://your-backend.up.railway.app

# If you expose backend on a non-default external port, set it (usually 443 on Railway)
PROXY_PORT=443

# Auth
JWT_SECRET=dev_jwt_change_me
JWT_REFRESH_SECRET=dev_refresh_change_me

# Database (Sequelize) — main Railway DB for tickets, messages, pipeline, etc.
# Prefer one full URL for production to ensure runtime + migrations hit the same DB.
PANEL_DATABASE_URL=
RAILWAY_DATABASE_URL=
DB_DIALECT=postgres
DB_HOST=...
DB_PORT=5432
DB_NAME=...
DB_USER=...
DB_PASS=...
# Optional: enable SSL for Postgres (some Railway/proxy setups)
DB_SSL=false

# Optional: direct Supabase connection for the vehicles catalog.
# When set, GET/DELETE /vehicles reads/writes go to Supabase directly —
# no sync script needed. Use the Pooler URL (port 6543) for best results:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
MELI_PUBLISH_ENABLED=false
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# WhatsApp provider
WHATSAPP_PROVIDER=EVOLUTION
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_API_KEY=your_evolution_apikey
EVOLUTION_WEBHOOK_SECRET=dev_webhook_change_me
EVOLUTION_POLL_MS=3000
# Optional fallback instance name (normally use the WhatsApp Connection 'name' inside the panel)
EVOLUTION_INSTANCE=

# Optional bot integration (WA bot service)
# If set, the backend will forward inbound messages to the bot. When an operator replies from the panel,
# we automatically set the conversation to HUMAN_ONLY via the bot admin API (prevents bot replying after takeover).
BOT_URL=https://your-bot.up.railway.app
BOT_WEBHOOK_SECRET=change_me
BOT_ADMIN_TOKEN=change_me

# Optional allow/block lists (comma-separated numbers without +)
#WHATSAPP_ALLOWLIST=5492491111111,5492492222222
#WHATSAPP_BLOCKLIST=
